{
  "name": "squishbox",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Kids' digital collectible prototype: open blind boxes of squishy dumplings, collect by rarity, trade safely.",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "vitest": "^3.2.0"
  }
}
